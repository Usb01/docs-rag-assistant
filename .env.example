# All optional. With nothing set, retrieval is BM25 and answers are extractive.
OPENAI_API_KEY=            # enables embeddings (hybrid search) and, with LLM_PROVIDER=openai, generated answers
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDINGS=on              # set to off to keep keyword-only search even with a key

LLM_PROVIDER=none          # none | openai | anthropic
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

DOCS_DIR=sample_docs       # indexed on startup
DB_PATH=index.db
